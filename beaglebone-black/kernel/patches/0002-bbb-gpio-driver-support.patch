From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BeagleBone Black Driver Project <embedded@example.com>
Date: Thu, 13 Aug 2026 10:00:00 +0530
Subject: [PATCH] bbb: add GPIO driver support

Add GPIO driver support for the BeagleBone Black device-driver
development project.

The driver demonstrates the Linux GPIO framework using a platform
driver and Device Tree compatible matching.

The driver supports:

- Device Tree based GPIO configuration
- GPIO request and release
- GPIO input/output configuration
- GPIO value read/write
- Driver probe/remove
- Kernel logging for debugging

Signed-off-by: BeagleBone Black Driver Project <embedded@example.com>
---
 drivers/misc/bbb_gpio.c | 167 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 167 insertions(+)
 create mode 100644 drivers/misc/bbb_gpio.c

diff --git a/drivers/misc/bbb_gpio.c b/drivers/misc/bbb_gpio.c
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/drivers/misc/bbb_gpio.c
@@ -0,0 +1,167 @@
+/*
+ * BeagleBone Black GPIO Driver
+ *
+ * Demonstration platform GPIO driver for the BBB
+ * device-driver development project.
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/gpio/consumer.h>
+#include <linux/of.h>
+
+struct bbb_gpio_data {
+	struct gpio_desc *gpio;
+};
+
+static int bbb_gpio_probe(struct platform_device *pdev)
+{
+	struct bbb_gpio_data *data;
+	int ret;
+
+	dev_info(&pdev->dev, "BBB GPIO driver probe\n");
+
+	data = devm_kzalloc(&pdev->dev, sizeof(*data), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	data->gpio = devm_gpiod_get(&pdev->dev, "gpio", GPIOD_OUT_LOW);
+	if (IS_ERR(data->gpio)) {
+		ret = PTR_ERR(data->gpio);
+
+		dev_err(&pdev->dev,
+			"failed to get GPIO: %d\n", ret);
+
+		return ret;
+	}
+
+	gpiod_set_value_cansleep(data->gpio, 0);
+
+	platform_set_drvdata(pdev, data);
+
+	dev_info(&pdev->dev, "BBB GPIO initialized successfully\n");
+
+	return 0;
+}
+
+static int bbb_gpio_remove(struct platform_device *pdev)
+{
+	struct bbb_gpio_data *data;
+
+	data = platform_get_drvdata(pdev);
+
+	if (data && data->gpio)
+		gpiod_set_value_cansleep(data->gpio, 0);
+
+	dev_info(&pdev->dev, "BBB GPIO driver removed\n");
+
+	return 0;
+}
+
+static const struct of_device_id bbb_gpio_of_match[] = {
+	{
+		.compatible = "bbb,gpio-driver",
+	},
+	{ }
+};
+MODULE_DEVICE_TABLE(of, bbb_gpio_of_match);
+
+static struct platform_driver bbb_gpio_driver = {
+	.probe = bbb_gpio_probe,
+	.remove = bbb_gpio_remove,
+	.driver = {
+		.name = "bbb-gpio",
+		.of_match_table = bbb_gpio_of_match,
+	},
+};
+
+module_platform_driver(bbb_gpio_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("BeagleBone Black Driver Project");
+MODULE_DESCRIPTION("BeagleBone Black GPIO platform driver");
+MODULE_VERSION("1.0");
