From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BeagleBone Black Driver Project <embedded@example.com>
Date: Thu, 13 Aug 2026 10:00:00 +0530
Subject: [PATCH] bbb: add UART driver support

Add an example UART platform driver for the BeagleBone Black
device-driver development project.

The driver demonstrates:

- Device Tree based UART device matching
- Platform driver probe/remove
- UART memory resource acquisition
- Register mapping
- Basic UART hardware initialization
- Kernel logging for debugging

The driver is intended for educational and driver-development
purposes. The standard Linux 8250/serial driver should normally
handle the AM335x UART hardware in production.

Signed-off-by: BeagleBone Black Driver Project <embedded@example.com>
---
 drivers/misc/bbb_uart.c | 214 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 214 insertions(+)
 create mode 100644 drivers/misc/bbb_uart.c

diff --git a/drivers/misc/bbb_uart.c b/drivers/misc/bbb_uart.c
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/drivers/misc/bbb_uart.c
@@ -0,0 +1,214 @@
+/*
+ * BeagleBone Black UART Driver
+ *
+ * Demonstration platform driver for UART hardware.
+ *
+ * NOTE:
+ * The BeagleBone Black AM335x UARTs are normally handled by the
+ * Linux serial/8250 subsystem. This driver is intended to
+ * demonstrate platform-driver concepts and should not bind to
+ * a UART already owned by the standard serial driver.
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/of.h>
+#include <linux/io.h>
+#include <linux/ioport.h>
+#include <linux/slab.h>
+
+/*
+ * AM335x UART register offsets.
+ *
+ * These definitions are provided for demonstration only.
+ * Production code should use the appropriate kernel serial
+ * subsystem rather than directly controlling an active UART.
+ */
+#define BBB_UART_THR		0x00
+#define BBB_UART_RHR		0x00
+#define BBB_UART_IER		0x04
+#define BBB_UART_LCR		0x0c
+#define BBB_UART_LSR		0x14
+
+#define BBB_UART_LSR_THRE	BIT(5)
+#define BBB_UART_LSR_DR	BIT(0)
+
+#define BBB_UART_LCR_8N1	0x03
+
+struct bbb_uart_data {
+	void __iomem *base;
+	resource_size_t size;
+};
+
+static void bbb_uart_write(struct bbb_uart_data *data,
+			   u32 offset,
+			   u8 value)
+{
+	writeb(value, data->base + offset);
+}
+
+static u8 bbb_uart_read(struct bbb_uart_data *data,
+			u32 offset)
+{
+	return readb(data->base + offset);
+}
+
+static void bbb_uart_send_char(struct bbb_uart_data *data,
+			       u8 value)
+{
+	unsigned int timeout = 100000;
+
+	while (!(bbb_uart_read(data, BBB_UART_LSR) &
+		 BBB_UART_LSR_THRE)) {
+		if (!timeout--)
+			return;
+		cpu_relax();
+	}
+
+	bbb_uart_write(data, BBB_UART_THR, value);
+}
+
+static int bbb_uart_probe(struct platform_device *pdev)
+{
+	struct bbb_uart_data *data;
+	struct resource *res;
+	int ret;
+
+	dev_info(&pdev->dev,
+		 "BBB UART driver probe\n");
+
+	res = platform_get_resource(pdev,
+				    IORESOURCE_MEM,
+				    0);
+	if (!res) {
+		dev_err(&pdev->dev,
+			"UART memory resource not found\n");
+		return -ENODEV;
+	}
+
+	data = devm_kzalloc(&pdev->dev,
+			    sizeof(*data),
+			    GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	data->size = resource_size(res);
+
+	data->base = devm_ioremap_resource(&pdev->dev, res);
+	if (IS_ERR(data->base)) {
+		ret = PTR_ERR(data->base);
+
+		dev_err(&pdev->dev,
+			"failed to map UART registers: %d\n",
+			ret);
+
+		return ret;
+	}
+
+	/*
+	 * Configure 8 data bits, no parity and 1 stop bit.
+	 *
+	 * This is intentionally minimal. Baud-rate programming,
+	 * interrupts, FIFO handling and the Linux TTY layer are not
+	 * implemented here because those functions belong to the
+	 * standard serial subsystem.
+	 */
+	bbb_uart_write(data,
+		       BBB_UART_LCR,
+		       BBB_UART_LCR_8N1);
+
+	/*
+	 * Disable UART interrupts for this demonstration driver.
+	 */
+	bbb_uart_write(data,
+		       BBB_UART_IER,
+		       0x00);
+
+	platform_set_drvdata(pdev, data);
+
+	dev_info(&pdev->dev,
+		 "BBB UART registers mapped successfully\n");
+
+	/*
+	 * Example character transmission.
+	 */
+	bbb_uart_send_char(data, 'B');
+	bbb_uart_send_char(data, 'B');
+	bbb_uart_send_char(data, 'B');
+	bbb_uart_send_char(data, '\n');
+
+	dev_info(&pdev->dev,
+		 "BBB UART initialized successfully\n");
+
+	return 0;
+}
+
+static int bbb_uart_remove(struct platform_device *pdev)
+{
+	struct bbb_uart_data *data;
+
+	data = platform_get_drvdata(pdev);
+
+	if (data)
+		dev_info(&pdev->dev,
+			 "BBB UART driver removed\n");
+
+	return 0;
+}
+
+static const struct of_device_id bbb_uart_of_match[] = {
+	{
+		.compatible = "bbb,uart-driver",
+	},
+	{ }
+};
+MODULE_DEVICE_TABLE(of, bbb_uart_of_match);
+
+static struct platform_driver bbb_uart_driver = {
+	.probe = bbb_uart_probe,
+	.remove = bbb_uart_remove,
+	.driver = {
+		.name = "bbb-uart",
+		.of_match_table = bbb_uart_of_match,
+	},
+};
+
+module_platform_driver(bbb_uart_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("BeagleBone Black Driver Project");
+MODULE_DESCRIPTION("BeagleBone Black UART platform driver");
+MODULE_VERSION("1.0");
